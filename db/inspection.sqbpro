CREATE TABLE formfield_labels ( formfield_id INTEGER PRIMARY KEY AUTOINCREMENT, formtype_id INTEGER NOT NULL, formfield_label TEXT, formfield_order INTEGER, section_no INTEGER, section_title TEXT, sub_no TEXT, field_type TEXT, has_remarks INTEGER DEFAULT 0, FOREIGN KEY (formtype_id) REFERENCES form_types(formtype_id) ON DELETE CASCADE )</sql><sql name="&amp;Foreign-Key Check">PRAGMA index_list(report_metadata);</sql><current_tab id="1"/></tab_sql></sqlb_project>
